#include <stdio.h>
 
int main() {
    float sub1, sub2, sub3,sub4, sub5, total, average , percentage ;                // assigning variables
    printf("enter the marks of five subjects: ");                                  // asking for input from user
    scanf("%f %f %f %f %f", &sub1, &sub2, &sub3, &sub4, &sub5);                   // taking input from user
    total = sub1 + sub2 + sub3 + sub4 + sub5;                                    // calculating total marks
    average = total / 5;                                                        // calculating average marks
    percentage = (total / 500) * 100;                                          // calculating percentage
    printf("-------Results-------\n");                                        // printing results
    printf("total marks: %f\n", total);                                      // printing total marks 
    printf("average marks: %f\n", average);                                 // printing average marks of 5 subjects
    printf("percentage: %f\n", percentage);                                // printing percentage of subjects
    return 0;
}
